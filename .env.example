# Downly Server Configuration
PORT=5000
NODE_ENV=development

# Security & CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000
TOKEN_SECRET=downly_secret_token_key_change_in_production_987654321

# Rate Limits (Requests per window)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_ANALYZE_MAX=15
RATE_LIMIT_DOWNLOAD_MAX=10
RATE_LIMIT_STREAM_MAX=30

# File & Storage Limits
MAX_FILE_SIZE_MB=500
PROCESSING_TIMEOUT_MS=30000

# Optional: RapidAPI Key for Vercel Serverless YouTube Extraction
# Get a free key at https://rapidapi.com/ (e.g. YouTube Media Downloader)
# When set in Vercel Environment Variables, this enables direct video streaming on Vercel
RAPIDAPI_KEY=
RAPIDAPI_HOST=youtube-media-downloader.p.rapidapi.com
